{
  "name": "peprn",
  "version": "1.0.0",
  "description": "parse, evaluate, print, and repeat nested subcommands in node or the browser",
  "author": "rdroe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdroe/peprn.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./match": {
      "types": "./dist/modules/match/index.d.ts",
      "default": "./dist/modules/match/index.js"
    },
    "./dom": {
      "types": "./dist/modules/dom/index.d.ts",
      "default": "./dist/modules/dom/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-examples.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/",
    "test:only": "tsc -p tsconfig.test.json && node --test dist-test/test/",
    "serve": "http-server examples/browser -p 8080 -c-1"
  },
  "devDependencies": {
    "@types/node": "^18.19.39",
    "@types/react": "^18.3.3",
    "esbuild": "^0.23.0",
    "http-server": "^14.1.1",
    "typescript": "~5.5.4"
  }
}
