{
  "author": "rdroe",
  "license": "MIT",
  "name": "peprn",
  "version": "0.4.21",
  "description": "parse, evaluate, print, and repeat nested subcommands in node or the browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdroe/peprn.git"
  },
  "dependencies": {
    "@testing-library/react": "^14.0.0",
    "@types/node": "^18.16.17",
    "@types/shelljs": "^0.8.12",
    "dexie": "^3.2.4",
    "react-dom": "^18.2.0",
    "shelljs": "^0.8.5",
    "source-map-support": "^0.5.21",
    "string-argv": "^0.3.2",
    "ts-node": "^10.9.1",
    "zod": "3.21.4"
  },
  "packageManager": "yarn@3.6.2",
  "devDependencies": {
    "@types/dexie": "^1.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.15.1",
    "esbuild": "^0.18.13",
    "eslint": "^9",
    "http-server": "^14.1.1",
    "jest": "^30.3.0",
    "nodemon": "2.0.22",
    "ts-jest": "^29.4.9",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.58.2"
  },
  "scripts": {
    "mon": "nodemon --exec \"yarn build\" --watch src --ext .ts,.js,.html",
    "build": "yarn tsc && node build.js",
    "lint": "eslint src",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "exports": {
    ".": "./dist/index.js",
    "./util": "./dist/util/index.js",
    "./browser": "./dist/browser.js",
    "./node": "./dist/node.js",
    "./match": "./dist/match/index.js",
    "./fakeCli": "./dist/fakeCli.js"
  },
  "main": "./dist/index.js",
  "engines": {
    "yarn": ">=2.0.0",
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "dist"
      ],
      "util": [
        "dist/util/index.d.ts"
      ],
      "browser": [
        "dist/browser.d.ts"
      ],
      "match": [
        "dist/match/index.d.ts"
      ],
      "node": [
        "dist/node.d.ts"
      ],
      "fakeCli": [
        "dist/fakeCli.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "react": "*"
  }
}
